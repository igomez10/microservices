{
  "uid": "urlshortener-overview",
  "title": "urlshortener — overview",
  "description": "Is urlshortener up, and are its requests succeeding. Managed by Terraform (igomez10/microservices: urlshortener/terraform); edits in the UI are overwritten on the next apply.",
  "tags": [
    "urlshortener",
    "terraform"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "urlshortener"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "urlshortener",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "API replicas available",
      "description": "Deployment urlshortener. 0 means every request fails, including socialapp's /api/v1/urls.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_deployment_status_replicas_available{namespace=\"urlshortener\", deployment=\"urlshortener\"}",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Postgres instances ready",
      "description": "CloudNativePG cluster urlshortener-postgres; 3 when healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_ready{namespace=\"urlshortener\", pod=~\"urlshortener-postgres-[0-9]+\", condition=\"true\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "5xx responses (selected range)",
      "description": "Requests urlshortener answered with 5xx, from its own request log. Anything above 0 is worth a look.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({k8s_namespace_name=\"urlshortener\", k8s_container_name=\"urlshortener\"} |= \"finished request\" | json | msg=\"finished request\" | status_code=~\"5..\" [$__range])) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "description": "From urlshortener's own 'finished request' log line; no proxy sits in front of it. Nearly all traffic is socialapp (user agent 'socialapp').",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status_code) (rate({k8s_namespace_name=\"urlshortener\", k8s_container_name=\"urlshortener\"} |= \"finished request\" | json | msg=\"finished request\" [$__auto]))",
          "refId": "A",
          "legendFormat": "{{status_code}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "5xx ratio",
      "description": "Share of requests answered with 5xx. The 'API 5xx rate high' alert fires above 5%.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(sum(count_over_time({k8s_namespace_name=\"urlshortener\", k8s_container_name=\"urlshortener\"} |= \"finished request\" | json | msg=\"finished request\" | status_code=~\"5..\" [$__auto])) or vector(0)) / sum(count_over_time({k8s_namespace_name=\"urlshortener\", k8s_container_name=\"urlshortener\"} |= \"finished request\" | json | msg=\"finished request\" [$__auto]))",
          "refId": "A",
          "legendFormat": "5xx ratio",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by route",
      "description": "By chi route pattern, so aliases do not explode the series count.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (method, x_pattern) (rate({k8s_namespace_name=\"urlshortener\", k8s_container_name=\"urlshortener\"} |= \"finished request\" | json | msg=\"finished request\" [$__auto]))",
          "refId": "A",
          "legendFormat": "{{method}} {{x_pattern}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      }
    },
    {
      "type": "table",
      "title": "Non-2xx requests by route (selected range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "404 on /v1/urls/{alias}/data is mostly the integration test reading an alias after deleting it; 409 on POST /v1/urls is an alias that already exists.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (method, x_pattern, status_code, user_agent) (count_over_time({k8s_namespace_name=\"urlshortener\", k8s_container_name=\"urlshortener\"} |= \"finished request\" | json | msg=\"finished request\" | status_code!~\"2..\" [$__range])))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      }
    }
  ]
}
