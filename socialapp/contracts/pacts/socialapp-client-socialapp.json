{
  "consumer": {
    "name": "socialapp-client"
  },
  "interactions": [
    {
      "description": "a request to create a comment",
      "providerState": "a comment can be posted",
      "request": {
        "body": {
          "content": "Hello from Pact",
          "username": "pact-user"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/v1/comments"
      },
      "response": {
        "body": {
          "content": "Hello from Pact",
          "created_at": "2000-02-01T12:30:00Z",
          "id": 42,
          "username": "pact-user"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.created_at": {
            "match": "regex",
            "regex": "^([\\+-]?\\d{4}(?!\\d{2}\\b))((-?)((0[1-9]|1[0-2])(\\3([12]\\d|0[1-9]|3[01]))?|W([0-4]\\d|5[0-2])(-?[1-7])?|(00[1-9]|0[1-9]\\d|[12]\\d{2}|3([0-5]\\d|6[1-6])))([T\\s]((([01]\\d|2[0-3])((:?)[0-5]\\d)?|24\\:?00)([\\.,]\\d+(?!:))?)?(\\17[0-5]\\d([\\.,]\\d+)?)?([zZ]|([\\+-])([01]\\d|2[0-3]):?([0-5]\\d)?)?)?)?$"
          },
          "$.body.id": {
            "match": "type"
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to create a scope",
      "providerState": "a scope can be created",
      "request": {
        "body": {
          "description": "Read data from Socialapp",
          "name": "socialapp.read"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/v1/scopes"
      },
      "response": {
        "body": {
          "created_at": "2000-02-01T12:30:00Z",
          "description": "Read data from Socialapp",
          "id": 42,
          "name": "socialapp.read"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.created_at": {
            "match": "regex",
            "regex": "^([\\+-]?\\d{4}(?!\\d{2}\\b))((-?)((0[1-9]|1[0-2])(\\3([12]\\d|0[1-9]|3[01]))?|W([0-4]\\d|5[0-2])(-?[1-7])?|(00[1-9]|0[1-9]\\d|[12]\\d{2}|3([0-5]\\d|6[1-6])))([T\\s]((([01]\\d|2[0-3])((:?)[0-5]\\d)?|24\\:?00)([\\.,]\\d+(?!:))?)?(\\17[0-5]\\d([\\.,]\\d+)?)?([zZ]|([\\+-])([01]\\d|2[0-3]):?([0-5]\\d)?)?)?)?$"
          },
          "$.body.id": {
            "match": "type"
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to create a user",
      "providerState": "a user can be created",
      "request": {
        "body": {
          "email": "pact@example.com",
          "first_name": "Pact",
          "last_name": "Tester",
          "password": "pact-secret",
          "username": "pact-user"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.email": {
            "match": "regex",
            "regex": ".+@.+\\..+"
          }
        },
        "method": "POST",
        "path": "/v1/users"
      },
      "response": {
        "body": {
          "created_at": "2000-02-01T12:30:00Z",
          "email": "pact@example.com",
          "first_name": "Pact",
          "id": 42,
          "last_name": "Tester",
          "username": "pact-user"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.created_at": {
            "match": "regex",
            "regex": "^([\\+-]?\\d{4}(?!\\d{2}\\b))((-?)((0[1-9]|1[0-2])(\\3([12]\\d|0[1-9]|3[01]))?|W([0-4]\\d|5[0-2])(-?[1-7])?|(00[1-9]|0[1-9]\\d|[12]\\d{2}|3([0-5]\\d|6[1-6])))([T\\s]((([01]\\d|2[0-3])((:?)[0-5]\\d)?|24\\:?00)([\\.,]\\d+(?!:))?)?(\\17[0-5]\\d([\\.,]\\d+)?)?([zZ]|([\\+-])([01]\\d|2[0-3]):?([0-5]\\d)?)?)?)?$"
          },
          "$.body.id": {
            "match": "type"
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-go": {
      "version": "2.4.2"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "mockserver": "1.2.16",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "2.0.0"
    }
  },
  "provider": {
    "name": "socialapp"
  }
}