    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch socialapp",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "cmd/main.go",
            "args": [
                "--port=8085",
                "--proxy=http://localhost:9091",
                "--puttyknifeDomain=puttyknife-server.localhostgomezignacio.com",
                "--puttyknife-url=http://localhost:8096",
                "--urlShortenerURL=http://localhost:9097",
            ],
            "cwd": ".",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Launch integration tests",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "integration_tests/main.go",
            "args": [],
            "cwd": ".",
            "env": {
                "APP_HOST": "http://localhost:8085",
                "HTTP_PROXY": "http://localhost:9091",
                "HTTPS_PROXY": "http://localhost:9091",
                "AGENT_URL": "http://localhost:4317",
            },
            // "envFile": "${workspaceFolder}/.env",
        }
    ]
}
