{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Connect to server",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "${workspaceFolder}",
            "port": 2345,
            "host": "127.0.0.1"
        },
        {
            "name": "Attach to dev-server-debug (dlv :2345)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 2345,
            "host": "127.0.0.1",
            "cwd": "${workspaceFolder:socialapp}",
            "substitutePath": [
                { "from": "${workspaceFolder:socialapp}", "to": "${workspaceFolder:socialapp}" }
            ],
            "showLog": true,
            "trace": "log",
            "logOutput": "rpc"
        },
        {
            "name": "Launch socialapp",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "cmd/main.go",
            "cwd": ".",
            "envFile": "${workspaceFolder}/.env_vscode_debug"
        },
        {
            "name": "Launch integration tests",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "integration_tests/main.go",
            "args": [],
            "cwd": ".",
            "env": {
                "APP_HOST": "http://localhost:8086",
            },
            "envFile": "${workspaceFolder}/.env_vscode_debug",
        }
    ]
}
