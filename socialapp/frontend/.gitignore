node_modules
/dist
/.env
/.env.*
/.cache
/playwright-report
/test-results

# Compiled output of the TypeScript config files (tsc -b emits these next to
# their sources). Vite resolves vite.config.js BEFORE vite.config.ts, so a
# stale committed .js silently shadows the real config.
*.tsbuildinfo
/vite.config.js
/vite.config.d.ts
/playwright.config.js
/playwright.config.d.ts
/vitest.*.config.js
/vitest.*.config.d.ts
