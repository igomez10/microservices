{
  "uid": "socialapp-logs",
  "title": "socialapp \u2014 logs",
  "description": "The API's own logs, from Loki. Managed by Terraform (igomez10/microservices: socialapp/terraform); edits in the UI are overwritten on the next apply.",
  "tags": [
    "socialapp",
    "terraform"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "socialapp"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "socialapp",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "API log lines by level",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({k8s_namespace_name=\"socialapp\", k8s_container_name=\"socialapp\"} | json level [$__auto]))",
          "refId": "A",
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "logs",
      "title": "API errors (excluding rollout shutdown noise)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{k8s_namespace_name=\"socialapp\", k8s_container_name=\"socialapp\"} | json | level=\"ERROR\" | msg!=\"failed to shutdown\"",
          "refId": "A",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 2,
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 8
      }
    }
  ]
}
